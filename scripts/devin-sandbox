#!/usr/bin/env bash
set -Eeuo pipefail

# Create (or reuse) a Devin Docker Sandbox from the kit, place the Devin
# credentials inside it, and attach.
#
# Docker Sandboxes' proxy-managed credential injection rewrites HTTP request
# headers only, while Devin CLI's wire protocol also embeds the API key inside
# each protobuf request body. The backend authenticates against the body copy,
# so header-only injection always yields "401 invalid api key". Until that
# changes on either side, the supported model is: copy the credentials file
# into the sandbox, and let the sandbox's network allowlist restrict where the
# credential can travel.

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() {
  printf 'devin-sandbox: %s\n' "$*" >&2
  exit 2
}

usage() {
  status="${1:-2}"
  cat >&2 <<'EOF'
Usage: devin-sandbox [options] [WORKSPACE...]

Options:
  -c, --credentials PATH  Devin credentials.toml to copy into the sandbox
                          (default: $XDG_DATA_HOME/devin/credentials.toml,
                           falling back to ~/.local/share/devin/credentials.toml)
  -n, --name NAME         Sandbox name (default: devin-<workspace>-<path hash>)
  -k, --kit DIR           Kit directory (default: sandbox-kit next to this script)
      --static-mcp NAMES   Preload comma-separated MCP servers (new sandboxes only)
      --refresh           Only (re)copy credentials into the sandbox, then exit
      --no-attach         Create and provision the sandbox without attaching
      --allow-unrestricted-egress
                          Copy credentials even when non-kit egress is allowed
  -h, --help              Show this help

WORKSPACE defaults to the current directory. Extra workspaces and ":ro"
suffixes are passed through to "sbx create" unchanged.
EOF
  exit "$status"
}

credentials=""
name=""
kit="$script_dir/../sandbox-kit"
refresh=false
attach=true
allow_unrestricted_egress=false
static_mcp=()
workspaces=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--credentials)  [[ $# -ge 2 ]] || die "$1 requires a value"; credentials="$2"; shift 2 ;;
    --credentials=*)   credentials="${1#*=}"; shift ;;
    -n|--name)         [[ $# -ge 2 ]] || die "$1 requires a value"; name="$2"; shift 2 ;;
    --name=*)          name="${1#*=}"; shift ;;
    -k|--kit)          [[ $# -ge 2 ]] || die "$1 requires a value"; kit="$2"; shift 2 ;;
    --kit=*)           kit="${1#*=}"; shift ;;
    --static-mcp)      [[ $# -ge 2 ]] || die "$1 requires a value"; static_mcp+=("$2"); shift 2 ;;
    --static-mcp=*)    static_mcp+=("${1#*=}"); shift ;;
    --refresh)         refresh=true; shift ;;
    --no-attach)       attach=false; shift ;;
    --allow-unrestricted-egress) allow_unrestricted_egress=true; shift ;;
    -h|--help)         usage 0 ;;
    --)                shift; workspaces+=("$@"); break ;;
    -*)                printf 'devin-sandbox: unknown option: %s\n\n' "$1" >&2; usage ;;
    *)                 workspaces+=("$1"); shift ;;
  esac
done

command -v sbx >/dev/null 2>&1 || die "sbx CLI not found; install Docker Sandboxes first"

if [[ -z "$credentials" ]]; then
  credentials="${XDG_DATA_HOME:-$HOME/.local/share}/devin/credentials.toml"
fi
[[ -r "$credentials" ]] || die "cannot read credentials file: $credentials
Authenticate once on a trusted machine (devin auth login) or pass --credentials PATH."

[[ ${#workspaces[@]} -gt 0 ]] || workspaces=(".")
primary="${workspaces[0]%%:*}"
[[ -d "$primary" ]] || die "workspace is not a directory: $primary"
canonical_primary="$(cd "$primary" && pwd -P)"

if [[ -z "$name" ]]; then
  workspace_slug="$(basename "$canonical_primary" | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9.-]+/-/g; s/^[^a-z0-9]+//; s/[^a-z0-9]+$//')"
  [[ -n "$workspace_slug" ]] || workspace_slug=workspace
  read -r workspace_hash _ < <(printf '%s' "$canonical_primary" | cksum)
  name="devin-${workspace_slug:0:32}-${workspace_hash}"
fi

[[ ${#name} -ge 2 && "$name" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] \
  || die "invalid sandbox name: $name (use letters, numbers, dots, and hyphens)"

sandbox_exists() {
  sbx inspect "$name" >/dev/null 2>&1
}

created=false
if sandbox_exists; then
  [[ ${#static_mcp[@]} -eq 0 ]] \
    || die "--static-mcp can only be selected when creating a sandbox"

  sandbox_summary="$(sbx inspect "$name")" \
    || die "cannot inspect existing sandbox: $name"
  existing_agent="$(printf '%s\n' "$sandbox_summary" \
    | sed -nE 's/^[[:space:]]*Agent:[[:space:]]+//p')"
  existing_workspace="$(printf '%s\n' "$sandbox_summary" \
    | sed -nE 's/^[[:space:]]*Workspace:[[:space:]]+//p')"
  [[ "$existing_agent" == devin ]] \
    || die "sandbox $name uses agent $existing_agent, not devin"
  [[ "$existing_workspace" == "$canonical_primary" ]] \
    || die "sandbox $name belongs to $existing_workspace, not $canonical_primary"
else
  $refresh && die "sandbox $name does not exist; run without --refresh first"
  [[ -f "$kit/spec.yaml" ]] || die "kit directory not found: $kit"
  create_args=(create --kit "$kit" --name "$name")
  for servers in "${static_mcp[@]}"; do
    create_args+=(--static-mcp "$servers")
  done
  sbx "${create_args[@]}" devin "${workspaces[@]}"
  created=true
fi

# The credentials are intentionally container-resident because Devin embeds
# its API key in protobuf request bodies. Fail closed unless a destination not
# declared by the kit is denied by the sandbox's effective policy.
policy_result="$(sbx policy check network --sandbox "$name" --json example.com)" \
  || die "cannot verify the effective network policy for $name"
if printf '%s\n' "$policy_result" | grep -Eq '"allowed"[[:space:]]*:[[:space:]]*true'; then
  if ! $allow_unrestricted_egress; then
    if $created; then
      sbx rm --force "$name" >/dev/null 2>&1 \
        || printf 'devin-sandbox: WARNING: could not remove rejected sandbox %s\n' "$name" >&2
    fi
    die "sandbox $name can reach non-kit destinations; refusing to copy credentials
Initialize a default-deny policy, or pass --allow-unrestricted-egress to accept the risk."
  fi
  printf 'devin-sandbox: WARNING: copying credentials with unrestricted egress enabled\n' >&2
fi

# Place the credentials where Devin CLI reads them. Stage the file, then install
# it as agent with restrictive directory and file modes. The file is copied
# verbatim rather than parsed or converted on the host; that keeps this
# compatible with both the current and pre-deprecation Windsurf formats.
target=/home/agent/.local/share/devin/credentials.toml
temporary_target="/tmp/devin-credentials-$$.toml"
sbx cp --follow-link "$credentials" "$name:$temporary_target"
sbx exec -u 0 "$name" -- sh -c '
  status=0
  install -d -m 700 -o agent -g agent "$(dirname "$2")" \
    && install -m 600 -o agent -g agent "$1" "$2" || status=$?
  rm -f "$1"
  exit "$status"
' sh "$temporary_target" "$target"
printf 'devin-sandbox: credentials installed in %s\n' "$name" >&2

if $refresh || ! $attach; then
  exit 0
fi

exec sbx run --name "$name"
